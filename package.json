{
  "name": "sazejchytre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:db": "cross-env NODE_OPTIONS=\"--no-deprecation --import tsx\" node --env-file-if-exists=.env --test \"src/**/*.db-test.ts\"",
    "test:stripe": "cross-env NODE_OPTIONS=\"--no-deprecation --import tsx\" node --env-file-if-exists=.env --test \"src/**/*.stripe-test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level high",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/billing.ts",
    "sync:prices": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/sync-stripe-prices.ts",
    "sync:prices:apply": "cross-env APPLY=1 NODE_OPTIONS=--no-deprecation payload run src/scripts/sync-stripe-prices.ts",
    "reconcile:subscriptions": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/reconcile-subscriptions.ts",
    "auth:migrate": "cross-env NODE_OPTIONS=\"--no-deprecation --import tsx\" node --env-file-if-exists=.env src/scripts/auth-migrate.ts",
    "auth:migrate:dry": "cross-env NODE_OPTIONS=\"--no-deprecation --import tsx\" node --env-file-if-exists=.env src/scripts/auth-migrate.ts --dry",
    "sweep:lockouts": "cross-env NODE_OPTIONS=\"--no-deprecation --import tsx\" node --env-file-if-exists=.env src/scripts/sweep-lockouts.ts",
    "seed:tips": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-tips.ts",
    "seed:tips:purge": "cross-env SEED_PURGE=1 NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-tips.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "better-auth": "1.7.10",
    "dejavu-fonts-ttf": "2.37.3",
    "graphql": "^16.11.0",
    "kysely": "0.29.6",
    "next": "16.3.8",
    "payload": "3.90.2",
    "pdfkit": "0.20.2",
    "pg": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "stripe": "23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
