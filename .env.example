# ---------------------------------------------------------------------------
# sazejchytre.cz — environment template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# Every variable below is REQUIRED. There are no code-side defaults: if one is
# missing or malformed the app refuses to boot (see src/lib/env.ts).
# Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production. Set automatically by Next.js and Vercel.
NODE_ENV=development

# --- Database (Neon Postgres) ----------------------------------------------
# Pooled Neon connection string. Use the *pooled* host (-pooler) for the app;
# migrations may need the direct host.
#
# Use `sslmode=verify-full`, not `sslmode=require`. Today `pg` silently treats
# `require` as `verify-full`, but pg 9 / pg-connection-string 3 will switch it
# to libpq semantics, where `require` encrypts without verifying the server
# certificate or hostname — so the same string would quietly stop protecting
# against an impersonated database host. Asking for `verify-full` explicitly
# keeps today's behaviour when that lands.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/sazejchytre?sslmode=verify-full

# --- Payload CMS -----------------------------------------------------------
# Signs auth tokens and reset links. Minimum 32 chars. Rotating it logs everyone
# out. Generate with:  openssl rand -base64 48
PAYLOAD_SECRET=

# --- Public app URL --------------------------------------------------------
# Canonical public origin, no trailing slash. Drives Payload cors/csrf, absolute
# URLs and callbacks. Locally: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Cloudflare R2 (media storage) -----------------------------------------
# Cloudflare account ID that owns the bucket (Cloudflare dashboard sidebar).
R2_ACCOUNT_ID=
# R2 API token access key ID, scoped to Object Read & Write on this bucket only.
R2_ACCESS_KEY_ID=
# R2 API token secret access key. Shown once at creation — store in a manager.
R2_SECRET_ACCESS_KEY=
# Bucket name, e.g. sazejchytre-media.
R2_BUCKET=
# Public origin media is served from (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_BASE_URL=https://cdn.sazejchytre.cz

# --- Upstash Redis ---------------------------------------------------------
# Defined now so a deploy fails fast if absent. Not consumed by code yet;
# intended for rate limiting and caching in a later step.
# REST endpoint of the Upstash database.
UPSTASH_REDIS_REST_URL=
# REST token for that database. Prefer a read-write token scoped to it.
UPSTASH_REDIS_REST_TOKEN=

# --- Transactional email (Resend) ------------------------------------------
# Sends verification, password reset and security-notice emails.
RESEND_API_KEY=
# Envelope sender, on a domain verified in Resend. An unverified domain makes
# every send fail at the API.
RESEND_FROM_EMAIL=no-reply@sazejchytre.cz

# --- Customer authentication (better-auth) ---------------------------------
# Signs customer session cookies and tokens. Minimum 32 chars, no default.
# Separate from PAYLOAD_SECRET on purpose: Payload auth is for admins,
# better-auth is for customers, and one key for both means one compromise for
# both. Rotating it signs every customer out.
# Generate with:  openssl rand -base64 48
BETTER_AUTH_SECRET=
# Canonical origin better-auth builds links and cookie scopes from, no trailing
# slash. Must match the host customers actually browse.
# Locally: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# --- Stripe (payments) -----------------------------------------------------
# Test keys for development, live keys only in production. Both are accepted by
# the schema — telling them apart is a runtime decision, so that the product
# reconciliation script can refuse to touch live data without an explicit flag.
# Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret of THE WEBHOOK ENDPOINT, not of the account. The dashboard
# endpoint and `stripe listen` each have their own; using one for the other
# fails every signature check and looks like a bug in our code.
#   local:  stripe listen --forward-to localhost:3000/webhooks/stripe
#   remote: Dashboard → Developers → Webhooks → your endpoint → signing secret
STRIPE_WEBHOOK_SECRET=

# --- Vercel Cron -----------------------------------------------------------
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on scheduled runs.
# Without it the cron route is a public endpoint anyone can call — and one of
# them deletes audit history. Minimum 32 chars.
# Generate with:  openssl rand -base64 48
CRON_SECRET=

# --- Billing ---------------------------------------------------------------
# Which payment provider is live: STRIPE. Optional — defaults to STRIPE.
# The billing registry resolves the adapter from this, so nothing outside
# src/lib/billing/ imports a provider SDK.
BILLING_PROVIDER=STRIPE

# Countries we are set up to sell into: comma-separated ISO 3166-1 alpha-2.
# Optional — defaults to CZ. Unlike the secrets above this has a default,
# because it is configuration with a correct launch value rather than a
# credential, and the default fails closed (one country, not all of them).
#
# Widening this is a tax decision, not a feature flag: each country adds a VAT
# regime, and cross-border B2C sales past the EU distance-selling threshold
# bring a filing obligation. Check euRevenueTotalMinor before adding one.
SUPPORTED_BILLING_COUNTRIES=CZ

# ---------------------------------------------------------------------------
# NOT WIRED YET — placeholders only.
# Do NOT uncomment until the step that consumes them lands; src/lib/env.ts would
# then demand a secret the code cannot use and every deploy would fail.
#
# Stripe and Resend used to be listed here. Both are now wired and REQUIRED
# above — Resend in step 3, Stripe in step 4.
# ---------------------------------------------------------------------------
# Cloudflare Turnstile — bot protection on forms
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
#
# Ecomail — marketing email lists
# ECOMAIL_API_KEY=
# ECOMAIL_LIST_ID=
