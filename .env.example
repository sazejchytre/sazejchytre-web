# ---------------------------------------------------------------------------
# sazejchytre.cz — environment template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# Every variable below is REQUIRED unless its comment says "Optional", and an
# optional one has a default that fails closed. If a required variable is
# missing, or any variable is malformed, the app refuses to boot (see
# src/lib/env.ts).
# Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production. Set automatically by Next.js and Vercel.
NODE_ENV=development

# --- Launch gate -----------------------------------------------------------
# Which parts of the app this deployment serves. Enforced on the server, in
# src/proxy.ts, for every request (see docs/DEPLOYMENT.md, "Launch gate").
#
#   PRIVATE        no public pages at all. Every page, informational ones
#                  included, answers 503 with a short Czech "temporarily
#                  unavailable" page. Only /healthz, the bearer-protected
#                  /api/cron/* routes and the admin (/admin, /api) answer.
#   INFORMATIONAL  the public informational site. Registration, sign-in,
#                  the account area, checkout and payment callbacks answer
#                  404, and the links to them are not rendered.
#   FULL           everything, including accounts and payments.
#
# Optional. Unset means PRIVATE, the narrowest mode: an environment that
# forgets this variable shows nothing public. Values are exact and
# upper-case; anything else (`full`, ` FULL`, `PUBLIC`) fails the boot rather
# than falling back to something wider.
#
# The template ships the safe value. For local development, change it in
# your own `.env` to what you are working on:
#   FULL           to work on sign-in, the account area or checkout
#   INFORMATIONAL  to see the public site exactly as it launches first
#   PRIVATE        to check the closed site (open http://localhost:3000/)
# Restart `pnpm dev` after changing it; it is read once at boot.
#
# Never set FULL on a public deployment before payments are approved for
# launch (docs/LAUNCH-CHECKLIST.md).
LAUNCH_MODE=PRIVATE

# --- Database (Neon Postgres) ----------------------------------------------
# Pooled Neon connection string. Use the *pooled* host (-pooler) for the app;
# migrations may need the direct host.
#
# Use `sslmode=verify-full`, not `sslmode=require`. Today `pg` silently treats
# `require` as `verify-full`, but pg 9 / pg-connection-string 3 will switch it
# to libpq semantics, where `require` encrypts without verifying the server
# certificate or hostname — so the same string would quietly stop protecting
# against an impersonated database host. Asking for `verify-full` explicitly
# keeps today's behaviour when that lands.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/sazejchytre?sslmode=verify-full

# --- Payload CMS -----------------------------------------------------------
# Signs auth tokens and reset links. Minimum 32 chars. Rotating it logs everyone
# out. Generate with:  openssl rand -base64 48
PAYLOAD_SECRET=

# --- Public app URL --------------------------------------------------------
# Canonical public origin, no trailing slash. Drives Payload cors/csrf, absolute
# URLs and callbacks. Locally: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Cloudflare R2 (media storage) -----------------------------------------
# Cloudflare account ID that owns the bucket (Cloudflare dashboard sidebar).
R2_ACCOUNT_ID=
# R2 API token access key ID, scoped to Object Read & Write on this bucket only.
R2_ACCESS_KEY_ID=
# R2 API token secret access key. Shown once at creation — store in a manager.
R2_SECRET_ACCESS_KEY=
# Bucket name, e.g. sazejchytre-media.
R2_BUCKET=
# A SEPARATE bucket for invoices and credit notes, e.g. sazejchytre-documents.
#
# It must NOT be the bucket above and must have NO public domain and NO r2.dev
# access. The public domain is bound to the media bucket at its ROOT, so a
# "private/" prefix inside it is still served publicly — which is why these
# live in a bucket of their own. The app refuses to store a document if this
# equals R2_BUCKET.
R2_DOCUMENTS_BUCKET=
# Public origin media is served from (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_BASE_URL=https://cdn.sazejchytre.cz

# --- Upstash Redis ---------------------------------------------------------
# Defined now so a deploy fails fast if absent. Not consumed by code yet;
# intended for rate limiting and caching in a later step.
# REST endpoint of the Upstash database.
UPSTASH_REDIS_REST_URL=
# REST token for that database. Prefer a read-write token scoped to it.
UPSTASH_REDIS_REST_TOKEN=

# --- Transactional email (Resend) ------------------------------------------
# Sends verification, password reset and security-notice emails.
RESEND_API_KEY=
# Envelope sender, on a domain verified in Resend. An unverified domain makes
# every send fail at the API.
RESEND_FROM_EMAIL=no-reply@sazejchytre.cz

# --- Customer authentication (better-auth) ---------------------------------
# Signs customer session cookies and tokens. Minimum 32 chars, no default.
# Separate from PAYLOAD_SECRET on purpose: Payload auth is for admins,
# better-auth is for customers, and one key for both means one compromise for
# both. Rotating it signs every customer out.
# Generate with:  openssl rand -base64 48
BETTER_AUTH_SECRET=
# Canonical origin better-auth builds links and cookie scopes from, no trailing
# slash. Must match the host customers actually browse.
# Locally: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# --- Stripe (payments) -----------------------------------------------------
# Test keys for development, live keys only in production. Both are accepted by
# the schema — telling them apart is a runtime decision, so that the product
# reconciliation script can refuse to touch live data without an explicit flag.
# Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# The SAME publishable key again, under a NEXT_PUBLIC_ name so Next inlines it
# into the browser bundle for the Payment Element. Only NEXT_PUBLIC_* names are
# inlined, so this cannot be derived from the line above. Keep the two equal —
# the server checks that they match on boot.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of THE WEBHOOK ENDPOINT, not of the account. The dashboard
# endpoint and `stripe listen` each have their own; using one for the other
# fails every signature check and looks like a bug in our code.
#   local:  stripe listen --forward-to localhost:3000/webhooks/stripe
#   remote: Dashboard → Developers → Webhooks → your endpoint → signing secret
STRIPE_WEBHOOK_SECRET=

# --- Vercel Cron -----------------------------------------------------------
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on scheduled runs.
# Without it the cron route is a public endpoint anyone can call — and one of
# them deletes audit history. Minimum 32 chars.
# Generate with:  openssl rand -base64 48
CRON_SECRET=

# --- Billing ---------------------------------------------------------------
# Which payment provider is live: STRIPE. Optional — defaults to STRIPE.
# The billing registry resolves the adapter from this, so nothing outside
# src/lib/billing/ imports a provider SDK.
BILLING_PROVIDER=STRIPE

# --- Accounting documents (Fakturoid) --------------------------------------
# Fakturoid is the system of record for invoices and correction documents. It
# allocates the numbers; we no longer do.
#
# !! THERE IS NO FAKTUROID SANDBOX !!
#
# These credentials point at a REAL accounting account. Every document created
# against it is a real document in a real statutory number series, and deleting
# one leaves a gap that has to be explained to a tax inspection. There is no
# undo.
#
# Which is why ACCOUNTING_PROVIDER defaults to FAKE and the real provider has
# to be asked for by name. Set it to FAKTUROID only where documents are meant
# to be issued for real: production, and nowhere else.
#
# Ordinary tests never touch it. `pnpm test:fakturoid` does, deliberately, and
# prints every document number it created so they can be accounted for. Run it
# once, read the numbers, file them.
ACCOUNTING_PROVIDER=FAKE

# OAuth 2 client credentials from Fakturoid: Settings -> API.
FAKTUROID_CLIENT_ID=
FAKTUROID_CLIENT_SECRET=
# The account slug, as it appears in app.fakturoid.cz/<slug>/.
FAKTUROID_SLUG=
# MANDATORY, and it must contain a contact email. Fakturoid answers 400 to any
# request without a User-Agent, and that 400 says nothing about headers.
FAKTUROID_USER_AGENT=sazejchytre.cz (kontakt@sazejchytre.cz)

# Countries we are set up to sell into: comma-separated ISO 3166-1 alpha-2.
# Optional — defaults to CZ. Unlike the secrets above this has a default,
# because it is configuration with a correct launch value rather than a
# credential, and the default fails closed (one country, not all of them).
#
# Widening this is a tax decision, not a feature flag: each country adds a VAT
# regime, and cross-border B2C sales past the EU distance-selling threshold
# bring a filing obligation. Check euRevenueTotalMinor before adding one.
SUPPORTED_BILLING_COUNTRIES=CZ

# ---------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE — bot defence on the public forms
# ---------------------------------------------------------------------------
# Both are REQUIRED. The site key renders the widget; the secret key is what
# actually verifies the token on the server. A deploy with only the site key
# set has a form that LOOKS protected and is not, so a missing secret fails
# the boot instead.
#
# For local development, use Cloudflare's own documented test keys, which
# always pass and talk to nobody:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
# The always-FAILS pair is 2x00000000000000000000AB with the same secret,
# which is how to exercise the refusal path by hand.
#
# Real keys: Cloudflare dashboard -> Turnstile -> add a widget for the domain.
#
# Note the site key is NOT a NEXT_PUBLIC_ name even though it is world-
# readable: a NEXT_PUBLIC_ value is inlined at build time, and the widget
# should be rotatable without a rebuild. The server hands it to the widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# ECOMAIL — the newsletter list
# ---------------------------------------------------------------------------
# Both REQUIRED. The key goes in the `key` header (not Authorization), and the
# API host is api2.ecomailapp.cz.
#
# ECOMAIL_LIST_ID must be the NUMERIC list id, not the list name: it goes
# straight into the request path, and a name there produces a 404 that reads
# like an authentication failure.
#
# Ecomail -> Settings -> Integrations -> API for the key; the list id is in the
# URL of the list in the Ecomail admin.
#
# Double opt-in stays ON in code (`skip_confirmation: false`), so a subscriber
# is added unconfirmed until they click the confirmation email.
ECOMAIL_API_KEY=
ECOMAIL_LIST_ID=

# ---------------------------------------------------------------------------
# NOT WIRED YET — nothing.
# Every variable this codebase reads is listed above. Stripe, Resend,
# Fakturoid, Turnstile and Ecomail are all wired and required.
# ---------------------------------------------------------------------------
