# ---------------------------------------------------------------------------
# sazejchytre.cz — environment template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# Every variable below is REQUIRED. There are no code-side defaults: if one is
# missing or malformed the app refuses to boot (see src/lib/env.ts).
# Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production. Set automatically by Next.js and Vercel.
NODE_ENV=development

# --- Database (Neon Postgres) ----------------------------------------------
# Pooled Neon connection string. Use the *pooled* host (-pooler) for the app;
# migrations may need the direct host. Must include `?sslmode=require`.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/sazejchytre?sslmode=require

# --- Payload CMS -----------------------------------------------------------
# Signs auth tokens and reset links. Minimum 32 chars. Rotating it logs everyone
# out. Generate with:  openssl rand -base64 48
PAYLOAD_SECRET=

# --- Public app URL --------------------------------------------------------
# Canonical public origin, no trailing slash. Drives Payload cors/csrf, absolute
# URLs and callbacks. Locally: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Cloudflare R2 (media storage) -----------------------------------------
# Cloudflare account ID that owns the bucket (Cloudflare dashboard sidebar).
R2_ACCOUNT_ID=
# R2 API token access key ID, scoped to Object Read & Write on this bucket only.
R2_ACCESS_KEY_ID=
# R2 API token secret access key. Shown once at creation — store in a manager.
R2_SECRET_ACCESS_KEY=
# Bucket name, e.g. sazejchytre-media.
R2_BUCKET=
# Public origin media is served from (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_BASE_URL=https://media.sazejchytre.cz

# --- Upstash Redis ---------------------------------------------------------
# Defined now so a deploy fails fast if absent. Not consumed by code yet;
# intended for rate limiting and caching in a later step.
# REST endpoint of the Upstash database.
UPSTASH_REDIS_REST_URL=
# REST token for that database. Prefer a read-write token scoped to it.
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# NOT WIRED YET — placeholders only.
# Do NOT uncomment until the step that consumes them lands; src/lib/env.ts would
# then demand a secret the code cannot use and every deploy would fail.
# ---------------------------------------------------------------------------
# Stripe — subscriptions and billing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_MONTHLY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
#
# Resend — transactional email
# RESEND_API_KEY=
#
# Cloudflare Turnstile — bot protection on forms
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
#
# Ecomail — marketing email lists
# ECOMAIL_API_KEY=
# ECOMAIL_LIST_ID=
